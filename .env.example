# BioPrint Vision — Environment Configuration Example

# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (0 = False, 1 = True)
FLASK_DEBUG=0

# Server Port
PORT=5000

# Database Configuration (MySQL 8.x)
# Set USE_MYSQL=1 to connect to MySQL server
USE_MYSQL=0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bioprint_vision
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Or specify a full DATABASE_URL (e.g. mysql+pymysql://root:password@localhost:3306/bioprint_vision)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/bioprint_vision

# Optional AI Assistant API Key (if external LLM provider is configured)
AI_API_KEY=your_optional_llm_api_key_here
